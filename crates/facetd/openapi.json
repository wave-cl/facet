        "summary": "Buckets of one key and width in time order (keys are window starts, values {start, count, sum, min, max})",
        "responses": {
          "200": {
            "description": "ok"
          }
        },
        "parameters": [
          {
            "name": "projection",
            "in": "path",
            "required": true,
            "description": "the projection",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "description": "the collection",
            "schema": {
              "type": "string"
