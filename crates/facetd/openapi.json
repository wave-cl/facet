    "/v1/projections/{projection}/{collection}/watch": {
      "get": {
        "summary": "Every committed batch's changes to the collection, from now on (server-sent events)",
        "responses": {
          "200": {
            "description": "a text/event-stream of changes: `data:` lines carrying a Change; an `event: error` line ends it"
          }
        },
        "parameters": [
          {
            "name": "projection",
            "in": "path",
            "required": true,
            "description": "the projection",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "description": "the collection",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "JSON: only this key",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "prefix",
            "in": "query",
            "required": false,
            "description": "JSON: only keys under this prefix",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This document",
        "responses": {
          "200": {
            "description": "ok"
          }
