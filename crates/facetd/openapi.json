        "parameters": [
          {
            "name": "projection",
            "in": "path",
            "required": true,
            "description": "the projection",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "description": "the collection",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "partition",
            "in": "query",
            "required": false,
