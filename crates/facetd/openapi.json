          },
          {
            "name": "at_least",
            "in": "query",
            "required": false,
            "description": "wait until the projection applied this position (a chron commit's next)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "wait_ms",
            "in": "query",
            "required": false,
            "description": "how long to wait for it (default 5000, max 30000)",
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
